# ============================================================
#  Todo_App — environment template
#
#  1. cp .env.example .env
#  2. Fill in the real values below (NEVER commit .env — it is gitignored)
#
#  Database docs: https://neon.com/docs/get-started/connect-neon
# ============================================================

# ---------- Application ----------
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- PostgreSQL (Neon) ----------
# Pooled connection (for the app at runtime) — Neon Console → Connect.
# Hostname contains "-pooler" and sslmode is required by Neon.
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct (unpooled) connection — same value without "-pooler" in the hostname.
# Use this one for migrations / psql / alembic (session-level features).
# DATABASE_URL_DIRECT="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# Neon requires TLS. Use "verify-full" for full certificate verification
# (Neon's recommendation), "require" as the minimum.
DATABASE_SSL_MODE=require

# Connection pool (read by backend/src/database/engine.py)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ---------- Auth / JWT ----------
# Generate a real one: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-64-char-random-hex
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ---------- CORS & security ----------
ALLOWED_ORIGINS=http://localhost:3000
CORS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
USE_HTTPS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ATTEMPTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# ---------- AI chat (optional — chat degrades gracefully without keys) ----------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REFERER=http://localhost:3000

# RAG / Qdrant (in Docker use QDRANT_URL=http://qdrant:6333)
QDRANT_URL=http://localhost:6333
RAG_COLLECTION=todo_documents
ALLOWED_DOCUMENT_PATH=/app/documents/

# ---------- Frontend (Next.js reads this from frontend/.env.local, not here) ----------
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
